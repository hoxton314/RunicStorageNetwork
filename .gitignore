# Publish only the paths listed here; all local working files stay local.
/*
!/.gitignore
!/.gitattributes
!/README.md
!/CHANGELOG_EN.md
!/CHANGELOG.md
!/CONTRIBUTING.md
!/BUILDING.md
!/manifest.json
!/RunicStorageNetwork.csproj
!/src/
/src/*
!/src/*.cs
!/tests/
/tests/*
!/tests/*.cs
!/tools/
/tools/*
!/tools/Compile.ps1
!/.github/
/.github/*
!/.github/ISSUE_TEMPLATE/
/.github/ISSUE_TEMPLATE/*
!/.github/ISSUE_TEMPLATE/*.yml

**/bin/
**/obj/
*.user
*.suo
*.dll
*.exe
*.pdb
*.log
.env*
